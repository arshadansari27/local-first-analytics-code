# Caddy reverse proxy with automatic HTTPS.
# Evidence is served as a static build out of /srv/evidence;
# Metabase is reverse-proxied to the metabase service in compose.

evidence.yourdomain.com {
    root * /srv/evidence
    file_server
    try_files {path} {path}/ /index.html
}

metabase.yourdomain.com {
    reverse_proxy metabase:3000
}
